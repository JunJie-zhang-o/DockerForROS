# syntax=docker/dockerfile:1.7
ARG BASE_IMAGE=ubuntu:20.04
FROM ${BASE_IMAGE}

SHELL ["/bin/bash", "-c"]

# ----------------------------------------------------------------------------
ARG USE_CN_MIRROR=true
ENV DEBIAN_FRONTEND=noninteractive \
    TZ=Asia/Shanghai \
    LANG=en_US.UTF-8 \
    LANGUAGE=en_US:en \
    LC_ALL=en_US.UTF-8 \
    PKG_CONFIG_PATH= \
    LD_LIBRARY_PATH= \
    PYTHONPATH= \
    CMAKE_PREFIX_PATH=

RUN cp /etc/apt/sources.list /etc/apt/sources.list.bak
RUN if [ "$USE_CN_MIRROR" = "true" ]; then \
        sed -i 's|http://archive.ubuntu.com/ubuntu/|http://mirrors.aliyun.com/ubuntu/|g' /etc/apt/sources.list; \
        sed -i 's|http://security.ubuntu.com/ubuntu|http://mirrors.aliyun.com/ubuntu|g' /etc/apt/sources.list; \
    fi
# ----------------------------------------------------------------------------

# ----------------------------------------------------------------------------
# 基础工具
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    apt-get update && \
    apt-get install -y \
    ca-certificates \
    curl \
    gnupg \
    lsb-release \
    locales \
    sudo \
    unzip \
    wget && \
    curl -fsSL -o /tmp/llvm-snapshot.gpg.key https://apt.llvm.org/llvm-snapshot.gpg.key && \
    gpg --dearmor -o /usr/share/keyrings/apt.llvm.org.gpg /tmp/llvm-snapshot.gpg.key && \
    rm /tmp/llvm-snapshot.gpg.key && \
    . /etc/os-release && \
    echo "deb [signed-by=/usr/share/keyrings/apt.llvm.org.gpg] http://apt.llvm.org/${UBUNTU_CODENAME}/ llvm-toolchain-${UBUNTU_CODENAME}-20 main" > /etc/apt/sources.list.d/llvm.list && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*
# ----------------------------------------------------------------------------

# ----------------------------------------------------------------------------
# 安装 Focal 版 ROS 2 Humble 离线包
COPY resources/ros-humble-focal.zip /tmp/ros-humble-focal.zip
RUN set -eux; \
    mkdir -p /tmp/ros-humble-focal; \
    unzip /tmp/ros-humble-focal.zip -d /tmp/; \
    chmod +x /tmp/ros-humble-focal/install.sh; \
    /tmp/ros-humble-focal/install.sh; \
    rm -rf /tmp/ros-humble-focal.zip /tmp/ros-humble-focal
# ----------------------------------------------------------------------------

# ----------------------------------------------------------------------------
# 系统依赖
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    apt-get update && \
    apt-get install -y \
    bash-completion \
    openssh-server \
    net-tools \
    nano \
    zsh \
    git \
    curl \
    bubblewrap \
    x11-apps \
    iproute2 \
    jq \
    iputils-ping \
    clangd-20 \
    libgoogle-glog-dev \
    sshpass \
    trash-cli \
    build-essential \
    cmake \
    pkg-config \
    fakeroot \
    debhelper \
    zip \
    tree \
    python3-pip \
    python3-venv \
    python3-rosdep \
    dnsutils \
    libasio-dev \
    libboost-filesystem-dev \
    libboost-regex-dev \
    libboost-serialization-dev \
    libboost-thread-dev \
    libeigen3-dev \
    libfmt-dev \
    libhdf5-dev \
    libnl-3-dev \
    libspdlog-dev \
    libzmq3-dev \
    sysstat && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*
RUN update-alternatives --install /usr/bin/clangd clangd /usr/bin/clangd-20 100

# 生成 locale，兼容宿主机通过 SSH 传入的 zh_CN.UTF-8 类别变量
RUN sed -i 's/^# *\(en_US.UTF-8 UTF-8\)/\1/' /etc/locale.gen && \
    sed -i 's/^# *\(zh_CN.UTF-8 UTF-8\)/\1/' /etc/locale.gen && \
    locale-gen en_US.UTF-8 zh_CN.UTF-8 && \
    update-locale LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8 LANGUAGE=en_US:en
# ----------------------------------------------------------------------------

# ----------------------------------------------------------------------------
# Python 依赖
RUN --mount=type=cache,target=/root/.cache/pip \
    if [ "$USE_CN_MIRROR" = "true" ]; then \
        pip3 install \
            pytest \
            pytest-dependency \
            pytest-env \
            bloom \
            sh \
            requests \
            loguru \
            fire \
            plumbum \
            dataclasses-json \
            colcon-common-extensions \
            vcstool \
            -i https://pypi.tuna.tsinghua.edu.cn/simple; \
    else \
        pip3 install \
            pytest \
            pytest-dependency \
            pytest-env \
            bloom \
            sh \
            requests \
            loguru \
            fire \
            plumbum \
            dataclasses-json \
            colcon-common-extensions \
            vcstool; \
    fi
# ----------------------------------------------------------------------------

# ----------------------------------------------------------------------------
# pinocchio 3.4
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    mkdir -p /etc/apt/keyrings && \
    apt-get update && \
    apt-get install -qqy lsb-release curl && \
    curl http://robotpkg.openrobots.org/packages/debian/robotpkg.asc \
    | tee /etc/apt/keyrings/robotpkg.asc && \
    echo "deb [arch=amd64 signed-by=/etc/apt/keyrings/robotpkg.asc] http://robotpkg.openrobots.org/packages/debian/pub $(lsb_release -cs) robotpkg" \
    | tee /etc/apt/sources.list.d/robotpkg.list && \
    apt-get update && \
    apt-get install -qqy \
        robotpkg-casadi=3.6.7 \
        robotpkg-py38-casadi=3.6.7 \
        robotpkg-pinocchio=3.4.0 \
        robotpkg-py38-pinocchio=3.4.0 && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*
ENV PATH=/opt/openrobots/bin:$PATH \
    PKG_CONFIG_PATH=/opt/openrobots/lib/pkgconfig:$PKG_CONFIG_PATH \
    LD_LIBRARY_PATH=/opt/openrobots/lib:$LD_LIBRARY_PATH \
    PYTHONPATH=/opt/openrobots/lib/python3.8/site-packages:$PYTHONPATH \
    CMAKE_PREFIX_PATH=/opt/openrobots:$CMAKE_PREFIX_PATH
# ----------------------------------------------------------------------------

# 创建组和用户并指定 UID/GID
ARG USERNAME=ros
ARG UID=1002
ARG GID=1002
RUN if getent group $GID > /dev/null 2>&1; then \
        GROUP_NAME=$(getent group $GID | cut -d: -f1); \
        echo "Using existing group $GROUP_NAME (GID: $GID) for user $USERNAME"; \
    else \
        groupadd -g $GID "$USERNAME" && GROUP_NAME="$USERNAME"; \
        echo "Created new group $USERNAME (GID: $GID)"; \
    fi && \
    if id -u "$USERNAME" > /dev/null 2>&1; then \
        usermod -u $UID -g $GID -s /bin/zsh "$USERNAME"; \
    else \
        useradd -m -u $UID -g $GID -s /bin/zsh "$USERNAME"; \
    fi && \
    echo "$USERNAME:1234" | chpasswd && \
    usermod -aG sudo "$USERNAME" && \
    echo "Created user $USERNAME (UID: $UID, GID: $GID)"
# ----------------------------------------------------------------------------

# ----------------------------------------------------------------------------
# 安装 nvm 和 Node.js 20
USER root
RUN mkdir -p /usr/local/nvm && \
    curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/v0.39.7/install.sh | NVM_DIR=/usr/local/nvm bash && \
    export NVM_DIR="/usr/local/nvm" && \
    [ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh" && \
    nvm install 20 && \
    nvm use 20 && \
    nvm alias default 20 && \
    nvm cache clear && \
    chmod -R 777 /usr/local/nvm && \
    for rc in /root/.bashrc /home/ros/.bashrc /root/.zshrc /home/ros/.zshrc; do \
        if [ -f "$rc" ]; then \
            echo 'export NVM_DIR="/usr/local/nvm"' >> "$rc"; \
            echo '[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh" # This loads nvm' >> "$rc"; \
            echo '[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion" # This loads nvm bash_completion' >> "$rc"; \
        fi; \
    done
# ----------------------------------------------------------------------------

# ----------------------------------------------------------------------------
# 安装 zsh 及 oh-my-zsh 和插件
USER ros
ENV HOME=/home/ros
RUN sh -c "$(wget -O- https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)" --unattended
RUN git clone --depth=1 https://github.com/romkatv/powerlevel10k.git ${ZSH_CUSTOM:-$HOME/.oh-my-zsh/custom}/themes/powerlevel10k
RUN git clone --depth=1 https://github.com/zsh-users/zsh-autosuggestions ${ZSH_CUSTOM:-$HOME/.oh-my-zsh/custom}/plugins/zsh-autosuggestions
RUN git clone --depth=1 https://github.com/zsh-users/zsh-syntax-highlighting.git ${ZSH_CUSTOM:-$HOME/.oh-my-zsh/custom}/plugins/zsh-syntax-highlighting
RUN sed -i 's/^ZSH_THEME=".*"/ZSH_THEME="powerlevel10k\/powerlevel10k"/' ~/.zshrc
RUN sed -i 's/^plugins=(.*)/plugins=(git zsh-syntax-highlighting zsh-autosuggestions)/' ~/.zshrc
RUN echo "[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh" >> ~/.zshrc && \
    echo "export TERM=xterm-256color" >> ~/.zshrc && \
    echo "export TERM=xterm-256color" >> ~/.bashrc
COPY .p10k.zsh /home/ros/.p10k.zsh
# ----------------------------------------------------------------------------

# ----------------------------------------------------------------------------
# SSH 配置
USER root
RUN mkdir -p /etc/ssh /var/run/sshd
RUN ssh-keygen -A
RUN echo 'PasswordAuthentication yes' >> /etc/ssh/sshd_config
RUN echo 'PermitRootLogin yes' >> /etc/ssh/sshd_config
RUN echo 'Port 10027' >> /etc/ssh/sshd_config
# ----------------------------------------------------------------------------

# ----------------------------------------------------------------------------
# 缓存 rosdistro 镜像
COPY resources/rosdistro-master.zip /opt/
RUN unzip /opt/rosdistro-master.zip -d /opt/ && \
    mv /opt/rosdistro-master /opt/rosdistro && \
    rm -f /opt/rosdistro-master.zip
ENV ROSDISTRO_INDEX_URL=file:///opt/rosdistro/index-v4.yaml
# ----------------------------------------------------------------------------

# ----------------------------------------------------------------------------
# 处理 rosdep 的依赖问题
COPY resources/rosdep.humble.yaml /etc/ros/rosdep/sources.list.d/rosdep.yaml
COPY resources/rosdep.humble.yaml /etc/ros/rosdep/sources.list.d/rosdep_humble_focal.yaml
COPY resources/custom.humble.yaml /etc/ros/rosdep/sources.list.d/custom2.yaml
RUN mkdir -p /etc/ros/rosdep/sources.list.d && \
    rm -f /etc/ros/rosdep/sources.list.d/20-default.list && \
    echo "yaml file:///etc/ros/rosdep/sources.list.d/rosdep_humble_focal.yaml" > /etc/ros/rosdep/sources.list.d/99-default.list && \
    echo "yaml file:///etc/ros/rosdep/sources.list.d/rosdep.yaml" >> /etc/ros/rosdep/sources.list.d/99-default.list && \
    echo "yaml file:///opt/rosdistro/rosdep/base.yaml" >> /etc/ros/rosdep/sources.list.d/99-default.list && \
    echo "yaml file:///opt/rosdistro/rosdep/python.yaml" >> /etc/ros/rosdep/sources.list.d/99-default.list && \
    echo "yaml file:///opt/rosdistro/rosdep/ruby.yaml" >> /etc/ros/rosdep/sources.list.d/99-default.list && \
    echo "yaml file:///etc/ros/rosdep/sources.list.d/custom2.yaml" >> /etc/ros/rosdep/sources.list.d/99-default.list
USER ros
RUN rosdep update --include-eol-distros --rosdistro humble
USER root
# ----------------------------------------------------------------------------

# 安装 gen_deb 工具
COPY scripts/gen_deb.py /usr/local/bin/gen_deb.py
COPY scripts/gen_deb.py /usr/local/bin/gen_deb
COPY scripts/gen_zip.py /usr/local/bin/gen_zip.py
COPY scripts/gen_zip.py /usr/local/bin/gen_zip
COPY scripts/chfs.py /usr/local/bin/chfs
COPY scripts/postrm /usr/local/bin/postrm
RUN chmod +x /usr/local/bin/gen_deb && \
    chmod +x /usr/local/bin/gen_zip && \
    chmod +x /usr/local/bin/chfs
# ----------------------------------------------------------------------------

# ----------------------------------------------------------------------------
# 配置 ROS 2 环境变量
RUN for rc in /root/.bashrc /home/ros/.bashrc; do \
        touch "$rc"; \
        printf '%s\n' 'source /opt/ros/humble/setup.bash' >> "$rc"; \
        printf '%s\n' 'if [ -f /etc/profile.d/ros2_humble_cyclone.sh ]; then source /etc/profile.d/ros2_humble_cyclone.sh; fi' >> "$rc"; \
        printf '%s\n' 'export CMAKE_PREFIX_PATH=/opt/zj_humanoid:$CMAKE_PREFIX_PATH' >> "$rc"; \
        printf '%s\n' 'alias rm="echo \"Use trash instead of rm, or use /bin/rm to force delete\""' >> "$rc"; \
        printf '%s\n' 'umask 0002' >> "$rc"; \
    done && \
    for rc in /root/.zshrc /home/ros/.zshrc; do \
        touch "$rc"; \
        printf '%s\n' 'source /opt/ros/humble/setup.zsh' >> "$rc"; \
        # Keep ros2/colcon zsh completion available after sourcing overlay workspaces. \
        # Some ROS setup hooks rerun bashcompinit and drop earlier argcomplete registrations. \
        # The precmd hook restores missing registrations before the next interactive prompt. \
        printf '%s\n' '_ros2_register_argcomplete() {' >> "$rc"; \
        printf '%s\n' '    autoload -Uz bashcompinit && bashcompinit' >> "$rc"; \
        printf '%s\n' '    local _ros2_argcomplete_register=' >> "$rc"; \
        printf '%s\n' '    if command -v register-python-argcomplete3 >/dev/null 2>&1; then' >> "$rc"; \
        printf '%s\n' '        _ros2_argcomplete_register=register-python-argcomplete3' >> "$rc"; \
        printf '%s\n' '    elif command -v register-python-argcomplete >/dev/null 2>&1; then' >> "$rc"; \
        printf '%s\n' '        _ros2_argcomplete_register=register-python-argcomplete' >> "$rc"; \
        printf '%s\n' '    fi' >> "$rc"; \
        printf '%s\n' '    local _ros2_argcomplete_cmd' >> "$rc"; \
        printf '%s\n' '    for _ros2_argcomplete_cmd in ros2 rosidl colcon; do' >> "$rc"; \
        printf '%s\n' '        [[ -n "$_ros2_argcomplete_register" ]] && command -v "$_ros2_argcomplete_cmd" >/dev/null 2>&1 && eval "$("$_ros2_argcomplete_register" "$_ros2_argcomplete_cmd" 2>/dev/null)"' >> "$rc"; \
        printf '%s\n' '    done' >> "$rc"; \
        printf '%s\n' '}' >> "$rc"; \
        printf '%s\n' '_ros2_register_argcomplete' >> "$rc"; \
        printf '%s\n' '_ros2_refresh_argcomplete() {' >> "$rc"; \
        printf '%s\n' '    complete -p 2>/dev/null | grep -Eq '"'"'(^|[[:space:]])"?ros2"?$'"'"' && complete -p 2>/dev/null | grep -Eq '"'"'(^|[[:space:]])"?colcon"?$'"'"' || _ros2_register_argcomplete' >> "$rc"; \
        printf '%s\n' '}' >> "$rc"; \
        printf '%s\n' 'autoload -Uz add-zsh-hook && add-zsh-hook precmd _ros2_refresh_argcomplete' >> "$rc"; \
        printf '%s\n' 'if [ -f /etc/profile.d/ros2_humble_cyclone.sh ]; then source /etc/profile.d/ros2_humble_cyclone.sh; fi' >> "$rc"; \
        printf '%s\n' 'export CMAKE_PREFIX_PATH=/opt/zj_humanoid:$CMAKE_PREFIX_PATH' >> "$rc"; \
        printf '%s\n' 'alias rm="echo \"Use trash instead of rm, or use /bin/rm to force delete\""' >> "$rc"; \
        printf '%s\n' 'umask 0002' >> "$rc"; \
    done
# ----------------------------------------------------------------------------

ENV DISPLAY=:0

COPY entrypoint.sh /
COPY resources/depends.install.sh /tmp/depends.install.sh
RUN bash /tmp/depends.install.sh
ENTRYPOINT ["/entrypoint.sh"]

USER ros
WORKDIR /home/ros

EXPOSE 10027
CMD ["sshpass", "-p", "1234", "sudo", "/usr/sbin/sshd", "-D"]
